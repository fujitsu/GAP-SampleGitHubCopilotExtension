{
  "name": "fujitsu-gap-copilot",
  "displayName": "Fujitsu-GAP Copilot Custom Model",
  "description": "Azure AD auth integration for GitHub Copilot Chat custom model",
  "version": "1.0.4",
  "publisher": "fujitsu",
  "engines": {
    "vscode": "^1.145.3"
  },
  "categories": [
    "AI","Chat"
  ],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "Fujitsu-GAP",
        "displayName": "Fujitsu-GAP"
      }
    ],
    "configuration": {
      "title": "Fujitsu-GAP",
      "properties": {
        "fujitsuGap.tenantName": {
          "type": "string",
          "default": "",
          "description": "Tenant Name"
        },
        "fujitsuGap.clientId": {
          "type": "string",
          "default": "",
          "description": "Client ID"
        },
        "fujitsuGap.maxInputTokens": {
          "type": "number",
          "default": 262144,
          "description": "Max Input Tokens (既定値: 256K)"
        },
        "fujitsuGap.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable MSAL verbose and OpenID metadata HTTP diagnostic logging in the Developer Tools console (no reload required). Response bodies and authentication headers are not logged by the HTTP diagnostics. PII logging is disabled. Turn off after troubleshooting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/prepare-readme.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.5",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "~1.145.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.22.0"
  }
}